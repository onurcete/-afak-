{
  "expo": {
    "name": "Şafak+",
    "slug": "safak-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "safakplus",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.onurcete.safakplus",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Şafak günlüğünüze askerlik anısı fotoğrafı çekip eklemek için kamera erişimi gereklidir.",
        "NSPhotoLibraryUsageDescription": "Şafak günlüğünüze galerinizden fotoğraf seçip eklemek için galeri erişimi gereklidir."
      }
    },
    "android": {
      "package": "com.onurcete.safakplus",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#101216",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101216",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Şafak günlüğünüze galerinizden fotoğraf seçip eklemek için galeri erişimi gereklidir.",
          "cameraPermission": "Şafak günlüğünüze askerlik anısı fotoğrafı çekip eklemek için kamera erişimi gereklidir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
